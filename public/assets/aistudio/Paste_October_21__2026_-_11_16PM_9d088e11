To guarantee that no clip repeats until the entire collection from [nooresunnat.com/shortwhatsappbayan.php](https://nooresunnat.com/shortwhatsappbayan.php) has been heard, we wrap the selection and auto-reset cycle inside a single @Transaction.

Kotlin
package com.imtiaz.lifestyle.data.local

import androidx.room.*

@Entity(tableName = "bayan_clips")
data class BayanClipEntity(
    @PrimaryKey val id: String,
    val title: String, // Roman Urdu
    val audioUrl: String,
    val durationSec: Int,
    val isPlayed: Boolean = false
)

@Dao
interface BayanClipDao {
    @Query("SELECT * FROM bayan_clips WHERE isPlayed = 0 ORDER BY RANDOM() LIMIT 1")
    suspend fun getRandomUnplayedClip(): BayanClipEntity?

    @Query("UPDATE bayan_clips SET isPlayed = 1 WHERE id = :clipId")
    suspend fun markAsPlayed(clipId: String)

    @Query("UPDATE bayan_clips SET isPlayed = 0")
    suspend fun resetAllClips()

    @Insert(onConflict = OnConflictStrategy.IGNORE)
    suspend fun insertClips(clips: List<BayanClipEntity>)

    @Transaction
    suspend fun fetchNextClipAndIncrement(onCycleReset: () -> Unit): BayanClipEntity? {
        var clip = getRandomUnplayedClip()
        if (clip == null) {
            // Auto-Reset Cycle when all clips have been heard
            resetAllClips()
            onCycleReset()
            clip = getRandomUnplayedClip()
        }
        clip?.let { markAsPlayed(it.id) }
        return clip
    }
}
