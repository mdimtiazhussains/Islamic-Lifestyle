private fun syncBayanClipsFromWeb() {
    serviceScope.launch(Dispatchers.IO) {
        try {
            val url = java.net.URL("https://www.nooresunnat.com/shortwhatsappbayan.php")
            val connection = (url.openConnection() as java.net.HttpURLConnection).apply {
                connectTimeout = 10_000
                readTimeout = 10_000
                requestMethod = "GET"
            }

            val html = connection.inputStream.bufferedReader().use { it.readText() }

            // Match all MP3 links on the page
            val mp3Regex = Regex("""href=["']([^"']+\.mp3)["']""", RegexOption.IGNORE_CASE)
            val discoveredTracks = mutableListOf<BayanTrack>()

            mp3Regex.findAll(html).forEachIndexed { index, matchResult ->
                val rawLink = matchResult.groupValues[1]
                val fullUrl = if (rawLink.startsWith("http")) {
                    rawLink
                } else {
                    "https://www.nooresunnat.com/${rawLink.trimStart('/')}"
                }

                // Derive clean Roman Urdu title from the MP3 filename
                val rawName = fullUrl.substringAfterLast("/").removeSuffix(".mp3")
                val cleanTitle = java.net.URLDecoder.decode(rawName, "UTF-8")
                    .replace("_", " ")
                    .replace("-", " ")

                discoveredTracks.add(
                    BayanTrack(
                        id = "web_$index",
                        title = cleanTitle.ifBlank { "Short Bayan #${index + 1}" },
                        audioUrl = fullUrl,
                        durationSec = 120,
                        isPlayed = false
                    )
                )
            }

            if (discoveredTracks.isNotEmpty()) {
                synchronized(bayanPool) {
                    bayanPool.clear()
                    bayanPool.addAll(discoveredTracks.distinctBy { it.audioUrl })
                }
            }
        } catch (e: Exception) {
            // Keeps the built-in fallback list if the user has no internet on startup
            e.printStackTrace()
        }
    }
}
