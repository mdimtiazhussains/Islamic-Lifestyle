            }

            override fun onPlayerError(error: PlaybackException) {
                // If Adhan stream fails, still proceed to 30s interval or clean up
                player.release()
                exoPlayer = null
                startThirtySecondPostAdhanInterval(prayerName)
            }
        })

        player.setMediaItem(MediaItem.fromUri(adhanAudioUrl))
        player.prepare()
        player.play()
    }

    private fun startThirtySecondPostAdhanInterval(prayerName: String) {
        pipelineJob?.cancel()
        pipelineJob = serviceScope.launch {
            for (remaining in 30 downTo 1) {
                _state.value = PipelineState.PostAdhanInterval(prayerName, remaining)
                updateNotification("Routine Reminder starting in ${remaining}s...")
                delay(1_000L)
            }
            startZeroClickBayan()
        }
    }

    private fun startZeroClickBayan() {
        val nextClip = pickNextUnplayedBayan()
        updateNotification("Playing Reminder: ${nextClip.title}")

        val player = buildConfiguredPlayer()
        exoPlayer = player
        player.volume = 0.85f

        player.addListener(object : Player.Listener {
            override fun onPlaybackStateChanged(playbackState: Int) {
                if (playbackState == Player.STATE_ENDED) {
                    stopAndReleaseAll(stopForegroundService = true)
                }
            }

            override fun onPlayWhenReadyChanged(playWhenReady: Boolean, reason: Int) {
                // Immediately stop if a phone call or alarm takes audio focus
                if (!playWhenReady && reason == Player.PLAY_WHEN_READY_CHANGE_REASON_AUDIO_FOCUS_LOSS) {
                    stopAndReleaseAll(stopForegroundService = true)
                }
            }

            override fun onPlayerError(error: PlaybackException) {
                stopAndReleaseAll(stopForegroundService = true)
            }
        })

        player.setMediaItem(MediaItem.fromUri(nextClip.audioUrl))
        player.prepare()
        player.play()

        // Track progress for UI
        progressJob?.cancel()
        progressJob = serviceScope.launch {
            while (isActive && exoPlayer != null) {
                val p = exoPlayer ?: break
                val cur = (p.currentPosition / 1000L).toInt().coerceAtLeast(0)
                val tot = if (p.duration > 0) (p.duration / 1000L).toInt() else nextClip.durationSec
                _state.value = PipelineState.PlayingBayan(
                    title = nextClip.title,
                    currentSec = cur.coerceAtMost(tot),
                    totalSec = tot.coerceAtLeast(1),
                    volume = p.volume
                )
                delay(250L)
            }
        }
    }

    private fun pickNextUnplayedBayan(): BayanTrack {
        var unplayed = bayanPool.filter { !it.isPlayed }
        if (unplayed.isEmpty()) {
            // Auto-reset cycle once all clips have been heard
            bayanPool.forEach { it.isPlayed = false }
            unplayed = bayanPool
        }
        val chosen = unplayed.random()
        chosen.isPlayed = true
        return chosen
    }

    private fun buildConfiguredPlayer(): ExoPlayer {
        val httpFactory = DefaultHttpDataSource.Factory()
            .setConnectTimeoutMs(10_000) // 10-second timeout
            .setReadTimeoutMs(10_000)
            .setAllowCrossProtocolRedirects(true)

        val audioAttributes = AudioAttributes.Builder()
            .setUsage(C.USAGE_MEDIA)
            .setContentType(C.AUDIO_CONTENT_TYPE_SPEECH)
            .build()

        return ExoPlayer.Builder(this)
            .setMediaSourceFactory(DefaultMediaSourceFactory(httpFactory))
            .setAudioAttributes(audioAttributes, /* handleAudioFocus = */ true)
            .setHandleAudioBecomingNoisy(true)
            .build()
    }

    fun setBayanVolume(volume: Float) {
        val clamped = volume.coerceIn(0f, 1f)
        exoPlayer?.volume = clamped
        val current = _state.value
        if (current is PipelineState.PlayingBayan) {
            _state.value = current.copy(volume = clamped)
        }
    }

    fun stopAndReleaseAll(stopForegroundService: Boolean = true) {
        pipelineJob?.cancel()
        pipelineJob = null
        progressJob?.cancel()
        progressJob = null

        exoPlayer?.run {
            stop()
            release()
        }
        exoPlayer = null
        _state.value = PipelineState.Idle
        releaseWakeLock()

        if (stopForegroundService) {
            stopForeground(STOP_FOREGROUND_REMOVE)
            stopSelf()
        }
    }

    private fun acquireWakeLock() {
        if (wakeLock?.isHeld == true) return
        val pm = getSystemService(Context.POWER_SERVICE) as PowerManager
        wakeLock = pm.newWakeLock(
            PowerManager.PARTIAL_WAKE_LOCK,
            "AzanBayanApp::PostAdhanWakeLock"
        ).apply {
            // Hold for max 15 minutes as a safety ceiling
            acquire(15 * 60 * 1000L)
        }
    }

    private fun releaseWakeLock() {
        if (wakeLock?.isHeld == true) {
            wakeLock?.release()
        }
        wakeLock = null
    }

    private fun buildNotification(contentText: String): Notification {
        val channelId = "adhan_bayan_channel"
        val nm = getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
        if (nm.getNotificationChannel(channelId) == null) {
            nm.createNotificationChannel(
                NotificationChannel(channelId, "Adhan & Bayan Service", NotificationManager.IMPORTANCE_LOW)
            )
        }
        return NotificationCompat.Builder(this, channelId)
            .setContentTitle("Prayer & Routine Reminder")
            .setContentText(contentText)
            .setSmallIcon(android.R.drawable.ic_lock_silent_mode_off)
            .setOngoing(true)
            .build()
    }

    private fun updateNotification(contentText: String) {
        val nm = getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
        nm.notify(101, buildNotification(contentText))
    }

    override fun onDestroy() {
        stopAndReleaseAll(stopForegroundService = true)
        serviceScope.cancel()
        super.onDestroy()
    }
}
