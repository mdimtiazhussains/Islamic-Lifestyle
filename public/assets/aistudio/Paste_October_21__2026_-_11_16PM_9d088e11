sealed class ReminderUiState {
    object Idle : ReminderUiState()
    data class Countdown(val secondsRemaining: Int) : ReminderUiState()
    data class Playing(
        val title: String,
        val currentSec: Int,
        val totalSec: Int,
        val volume: Float
    ) : ReminderUiState()
}

@OptIn(UnstableApi::class)
class BayanPlaybackManager(
    private val context: Context,
    private val dao: com.imtiaz.lifestyle.data.local.BayanClipDao
) {
    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.Main)
    private var activeJob: Job? = null
    private var progressJob: Job? = null
    private var exoPlayer: ExoPlayer? = null

    private val _uiState = MutableStateFlow<ReminderUiState>(ReminderUiState.Idle)
    val uiState: StateFlow<ReminderUiState> = _uiState

    private var rotationCounter = 0

    // 50MB Local Audio Cache for offline/poor-network fallback
    private val simpleCache: SimpleCache by lazy {
        val cacheDir = File(context.cacheDir, "bayan_audio_cache")
        SimpleCache(
            cacheDir,
            LeastRecentlyUsedCacheEvictor(50L * 1024L * 1024L),
            StandaloneDatabaseProvider(context)
        )
    }

    /**
     * Hook called immediately when Fajr, Dhuhr, Asr, Maghrib, or Isha Adhan completes.
     */
    fun onAdhanCompleted() {
        // Rapid Re-trigger Suppression: cancel any active countdown or playback immediately
        stopAndRelease()

        activeJob = scope.launch {
            for (remaining in 30 downTo 1) {
                _uiState.value = ReminderUiState.Countdown(remaining)
                delay(1_000L)
            }
            startZeroClickBayan()
        }
    }

    private suspend fun startZeroClickBayan() {
        val clip = withContext(Dispatchers.IO) {
            dao.fetchNextClipAndIncrement { rotationCounter++ }
        } ?: run {
            _uiState.value = ReminderUiState.Idle
            return
        }

        // 10-second strict connection/read timeout
        val httpDataSourceFactory = DefaultHttpDataSource.Factory()
            .setConnectTimeoutMs(10_000)
            .setReadTimeoutMs(10_000)
            .setAllowCrossProtocolRedirects(true)

        val cacheDataSourceFactory = CacheDataSource.Factory()
            .setCache(simpleCache)
            .setUpstreamDataSourceFactory(httpDataSourceFactory)
            .setFlags(CacheDataSource.FLAG_IGNORE_CACHE_ON_ERROR)

        val audioAttributes = AudioAttributes.Builder()
            .setUsage(C.USAGE_MEDIA)
            .setContentType(C.AUDIO_CONTENT_TYPE_SPEECH)
            .build()

        val player = ExoPlayer.Builder(context)
            .setMediaSourceFactory(DefaultMediaSourceFactory(cacheDataSourceFactory))
            .setAudioAttributes(audioAttributes, /* handleAudioFocus = */ true)
            .setHandleAudioBecomingNoisy(true)
            .build()

        player.addListener(object : Player.Listener {
            override fun onPlaybackStateChanged(playbackState: Int) {
                if (playbackState == Player.STATE_ENDED) {
                    stopAndRelease()
                }
            }

            // If a phone call or alarm steals focus, halt immediately so it never clashes
            override fun onPlayWhenReadyChanged(playWhenReady: Boolean, reason: Int) {
                if (!playWhenReady && reason == Player.PLAY_WHEN_READY_CHANGE_REASON_AUDIO_FOCUS_LOSS) {
                    stopAndRelease()
                }
            }

            override fun onPlayerError(error: PlaybackException) {
                // Prevent hanging service or battery drain on network drop
                stopAndRelease()
            }
        })

        exoPlayer = player
        player.volume = 0.8f // Scoped strictly to player media stream; ringtone unaffected
        player.setMediaItem(MediaItem.fromUri(clip.audioUrl))
        player.prepare()
        player.play() // 100% Zero-Click Automated Playback

        startProgressTracker(clip.title, clip.durationSec)
    }

    private fun startProgressTracker(title: String, fallbackDurationSec: Int) {
        progressJob?.cancel()
        progressJob = scope.launch {
            while (isActive && exoPlayer != null) {
                val player = exoPlayer ?: break
                val currentSec = (player.currentPosition / 1000L).toInt()
                val totalSec = if (player.duration > 0) {
                    (player.duration / 1000L).toInt()
                } else {
                    fallbackDurationSec
                }

                _uiState.value = ReminderUiState.Playing(
                    title = title,
                    currentSec = currentSec.coerceAtMost(totalSec),
                    totalSec = totalSec.coerceAtLeast(1),
                    volume = player.volume
                )
                delay(250L)
            }
        }
    }

    fun setPlayerVolume(volume: Float) {
        val clamped = volume.coerceIn(0f, 1f)
        exoPlayer?.volume = clamped
        val currentState = _uiState.value
        if (currentState is ReminderUiState.Playing) {
            _uiState.value = currentState.copy(volume = clamped)
        }
    }

    fun stopAndRelease() {
        activeJob?.cancel()
        activeJob = null
        progressJob?.cancel()
        progressJob = null

        exoPlayer?.run {
            stop()
            release()
        }
        exoPlayer = null
        _uiState.value = ReminderUiState.Idle
    }
}
