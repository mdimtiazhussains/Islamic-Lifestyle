    fun triggerPrayerAdhan(prayerName: String, adhanAudioUrl: String) {
        // Rapid Re-trigger Suppression: cancel any active Adhan, timer, or Bayan
        stopAndReleaseAll(stopForegroundService = false)

        acquireWakeLock()
        startForeground(101, buildNotification("Playing $prayerName Adhan..."))

