                    else -> "https://www.nooresunnat.com/$rawPath"
                }

                // CRITICAL FIX: Encode spaces so ExoPlayer streams MP4/MP3 filenames with spaces
                val safeUrl = baseResolved.replace(" ", "%20")

                val fileName = baseResolved.substringAfterLast("/").substringBeforeLast(".")
                val cleanTitle = java.net.URLDecoder.decode(fileName, "UTF-8")
                    .replace("_", " ")
                    .replace("-", " ")
                    .trim()

                discoveredTracks.add(
                    BayanTrack(
                        id = "ns_$index",
                        title = cleanTitle.ifEmpty { "Short Bayan ${index + 1}" },
                        audioUrl = safeUrl,
                        durationSec = 90,
                        isPlayed = false
                    )
                )
            }

            if (discoveredTracks.isNotEmpty()) {
                synchronized(bayanPool) {
                    bayanPool.clear()
                    bayanPool.addAll(discoveredTracks.distinctBy { it.audioUrl })
                }
            }
        } catch (e: Exception) {
            e.printStackTrace() // Automatically keeps the verified fallback pool
        }
    }
}

private fun startZeroClickBayan() {
    val nextClip = pickNextUnplayedBayan()
    updateNotification("Playing Reminder: ${nextClip.title}")

    val player = buildConfiguredPlayer()
    exoPlayer = player
    player.volume = 0.85f

    player.addListener(object : Player.Listener {
        override fun onPlaybackStateChanged(playbackState: Int) {
            if (playbackState == Player.STATE_READY) {
                retryCount = 0 // Reset retry counter once audio starts streaming
            } else if (playbackState == Player.STATE_ENDED) {
                stopAndReleaseAll(stopForegroundService = true)
            }
        }

        override fun onPlayWhenReadyChanged(playWhenReady: Boolean, reason: Int) {
            if (!playWhenReady && reason == Player.PLAY_WHEN_READY_CHANGE_REASON_AUDIO_FOCUS_LOSS) {
                stopAndReleaseAll(stopForegroundService = true)
            }
        }

        override fun onPlayerError(error: PlaybackException) {
            // GUARANTEED PLAYBACK FAILOVER: If a scraped link fails, try the next track automatically
            player.release()
            exoPlayer = null
            if (retryCount < 3) {
                retryCount++
                startZeroClickBayan()
            } else {
                retryCount = 0
                stopAndReleaseAll(stopForegroundService = true)
            }
        }
    })

    // ExoPlayer plays the audio track of both .mp4 and .mp3 URLs automatically
    player.setMediaItem(MediaItem.fromUri(nextClip.audioUrl))
    player.prepare()
    player.play()

    progressJob?.cancel()
    progressJob = serviceScope.launch {
        while (isActive && exoPlayer != null) {
            val p = exoPlayer ?: break
            val cur = (p.currentPosition / 1000L).toInt().coerceAtLeast(0)
            val tot = if (p.duration > 0) (p.duration / 1000L).toInt() else nextClip.durationSec
            _state.value = PipelineState.PlayingBayan(
                title = nextClip.title,
                currentSec = cur.coerceAtMost(tot),
                totalSec = tot.coerceAtLeast(1),
                volume = p.volume
            )
            delay(250L)
        }
    }
}