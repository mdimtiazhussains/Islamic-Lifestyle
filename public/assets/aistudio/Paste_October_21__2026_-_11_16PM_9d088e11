    )

    inner class LocalBinder : Binder() {
        fun getService(): AdhanBayanForegroundService = this@AdhanBayanForegroundService
    }

    override fun onBind(intent: Intent?): IBinder = binder

    /**
     * Starts the full sequence:
     * 1. Plays full Adhan (2-4 mins)
     * 2. Waits 30 seconds after Adhan finishes (holding WakeLock)
